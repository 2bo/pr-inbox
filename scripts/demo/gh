const all = [...REVIEW, ...MINE, ...APPROVED]
const byUrl = (url) => all.find((p) => p.url === url)
const key = (p) => `${p.repository.nameWithOwner.split('/')[1]}/${p.number}`

const args = process.argv.slice(2)
const out = (v) => process.stdout.write(typeof v === 'string' ? v : JSON.stringify(v))

const fail = (msg) => {
  process.stderr.write(`${msg}\n`)
  process.exit(1)
}
const flag = (name) => {
  const i = args.indexOf(name)
  return i >= 0 ? args[i + 1] : undefined
}

// Review requests made in the demo (w), kept in a file for the demo's length (run.sh removes it): by repo#number, who
// is asked now and the events. A request to the web team becomes one of its members, as code review assignment does
const STATE = process.env.PR_INBOX_DEMO_STATE
const readState = () => {
  try {
    return STATE ? JSON.parse(fs.readFileSync(STATE, 'utf8')) : {}
  } catch {
    return {}
  }
}
const withRequests = (p) => {
  const s = readState()[key(p)]
  return s ? { ...p, reviewRequests: { nodes: s.asked.map((w) => ({ requestedReviewer: w })) }, requestEvents: { nodes: s.events } } : p
}
const WEB_TEAM = ['lena-park', 'mtanaka', 'rkumar']
const PEOPLE = [
  { login: 'lena-park', name: 'Lena Park' },
  { login: 'mtanaka', name: 'Mei Tanaka' },
  { login: 'rkumar', name: 'Ravi Kumar' },
  { login: 'sofia-ito', name: 'Sofia Ito' },
  { login: 'jbaker', name: 'Jo Baker' },
]
const TEAMS = [
  { slug: 'web', name: 'Web' },
  { slug: 'platform', name: 'Platform' },
]

if (args[0] === 'api' && args[1] === 'graphql') {
  const query = (args.find((a) => a.startsWith('query=')) ?? '').slice('query='.length)
  const number = Number(flag('-F')?.replace(/^number=/, ''))
  const repo = (args.find((a) => a.startsWith('name=')) ?? '').slice('name='.length)
  const mineHere = MINE.map(withRequests).find((p) => p.number === number && p.repository.nameWithOwner === `acme/${repo}`)
  const state = (p) => ({
    headRefOid: p.headRefOid,
    isDraft: p.isDraft,
    reviewDecision: p.reviewDecision,
    reviewRequests: p.reviewRequests,
    requestEvents: p.requestEvents,
    latestReviews: p.latestReviews,
  })
  if (query.includes('suggestedReviewers')) {
    // Your recent PRs here: the web team asked on both, mtanaka reviewing; merged PRs reviewed by rkumar
    out({
      data: {
        repository: { pullRequest: { ...state(mineHere ?? MINE[0]), suggestedReviewers: [{ isCommenter: false, reviewer: { login: 'sofia-ito' } }] } },
        mine: {
          nodes: [
            { number: 401, ...viaTeam('web', 'lena-park', 24 * 9), latestReviews: { nodes: [{ author: { login: 'lena-park' } }, { author: { login: 'jbaker' } }] } },
            { number: 402, ...viaTeam('web', 'mtanaka', 24 * 20), latestReviews: { nodes: [{ author: { login: 'jbaker' } }] } },
          ],
        },
        merged: { nodes: [{ latestReviews: { nodes: [{ author: { login: 'rkumar' } }, { author: { login: 'jbaker' } }] } }] },
      },
    })
  } else if (query.includes('reviewRequestDelegationEnabled')) {
    const data = {}
    for (let i = 0; args.some((a) => a.startsWith(`s${i}=`)); i++) {
      const slug = args.find((a) => a.startsWith(`s${i}=`)).slice(3)
      data[`t${i}`] = {
        team: {
          reviewRequestDelegationEnabled: slug === 'web',
          reviewRequestDelegationAlgorithm: 'ROUND_ROBIN',
          reviewRequestDelegationMemberCount: 1,
        },
      }
    }
    out({ data })
  } else if (query.includes('assignableUsers')) {
    const q = (args.find((a) => a.startsWith('q=')) ?? '').slice(2).toLowerCase()
    out({ data: { repository: { assignableUsers: { nodes: PEOPLE.filter((p) => `${p.login} ${p.name}`.toLowerCase().includes(q)) } } } })
  } else if (query.includes('...asked') && !query.includes('search(')) {
    out({ data: { repository: { pullRequest: mineHere ? state(mineHere) : null } } })
  } else {
    out({ data: { viewer: { login: 'you' }, review: { nodes: REVIEW }, mine: { nodes: MINE.map(withRequests) }, approved: { nodes: APPROVED } } })
  }
} else if (args[0] === 'api' && args.some((a) => /\/pulls\/\d+\/requested_reviewers$/.test(a))) {
  // Asking for reviews (w): remembered for the demo, so the list and the picker show it
  const m = args.find((a) => a.endsWith('/requested_reviewers')).match(/^repos\/acme\/([^/]+)\/pulls\/(\d+)\//)
  const p = MINE.find((x) => x.repository.nameWithOwner === `acme/${m[1]}` && x.number === Number(m[2]))
  if (!p) fail('gh: Not Found (HTTP 404)')
  const body = JSON.parse(fs.readFileSync(0, 'utf8') || '{}')
  const all = readState()
  const now = new Date().toISOString()
  const cur = all[key(p)] ?? {
    asked: (p.reviewRequests?.nodes ?? []).map((n) => n.requestedReviewer),
    events: p.requestEvents?.nodes ?? [],
  }
  const ids = (w) => w.login ?? w.combinedSlug
  if (flag('-X') === 'DELETE') {
    const gone = new Set([...(body.reviewers ?? []), ...(body.team_reviewers ?? []).map((t) => `acme/${t}`)])
    cur.asked = cur.asked.filter((w) => !gone.has(ids(w)))
  } else {
    for (const login of body.reviewers ?? []) if (!cur.asked.some((w) => w.login === login)) cur.asked.push(user(login))
    for (const slug of body.team_reviewers ?? []) {
      cur.events.push({ __typename: 'ReviewRequestedEvent', createdAt: now, requestedReviewer: team(slug) })
      if (slug !== 'web') {
        cur.asked.push(team(slug))
        continue
      }
      const pick = WEB_TEAM.find((l) => !cur.asked.some((w) => w.login === l)) ?? WEB_TEAM[0]
      cur.events.push({ __typename: 'ReviewRequestRemovedEvent', createdAt: now, requestedReviewer: team(slug) })
      cur.events.push({ __typename: 'ReviewRequestedEvent', createdAt: now, requestedReviewer: user(pick) })
      cur.asked.push(user(pick))
    }
  }
  all[key(p)] = cur
  if (STATE) fs.writeFileSync(STATE, JSON.stringify(all))
  out({ number: p.number })
} else if (args[0] === 'api' && args.includes('--input') && args.some((a) => /\/pulls\/\d+\/reviews$/.test(a))) {
  // A review from the AI findings (s): goes nowhere
  out({ state: 'COMMENTED' })
} else if (args[0] === 'api' && args.includes('event=APPROVE')) {
  out({ state: 'APPROVED' })
} else if (args[0] === 'api') {
  const path = args.find((a) => a.startsWith('repos/')) ?? ''
  let m
  if ((m = path.match(/^repos\/acme\/[^/]+\/teams$/))) {
    out(TEAMS)
  } else if ((m = path.match(/^repos\/([^/]+\/[^/]+)\/contents\/([^?]+)/))) {
    const file = FILES[m[1]]?.[decodeURIComponent(m[2])]
    if (file === undefined) fail('gh: Not Found (HTTP 404)')
    out(file)
  } else if ((m = path.match(/^repos\/([^/]+\/[^/]+)\/releases/))) {
    const r = RELEASES[m[1]]
    if (!r) fail('gh: Not Found (HTTP 404)')
    out(r)
  } else if ((m = path.match(/^repos\/([^/]+\/[^/]+)\/compare\//))) {
    // What changed since an approval: a made-up two commits, and the PR's own diff
    const p = APPROVED.find((x) => x.repository.nameWithOwner === m[1])
    if (args.includes('--jq')) out({ c: 2, a: 12, d: 3, by: [p?.author.login ?? 'someone'] })
    else out((p && DETAILS[key(p)]?.diff) || 'diff --git a/README.md b/README.md\n--- a/README.md\n+++ b/README.md\n@@ -1,1 +1,1 @@\n-old\n+new\n')
  } else if ((m = path.match(/^repos\/[^/]+\/([^/]+)\/pulls\/(\d+)\/comments$/))) {
    out(LINE_TALK[`${m[1]}/${m[2]}`] ?? [])
  } else fail(`fake gh: unsupported: gh ${args.join(' ')}`)
} else if (args[0] === 'pr' && args[1] === 'merge') {
  out('')
} else if (args[0] === 'stack' && args[1] === '--version') {
  out('gh stack version 0.2.0 (demo)')
} else if (args[0] === 'stack' && args[1] === 'merge') {
  out('')
} else if (args[0] === 'run' && args[1] === 'rerun') {
  out('')
} else if (args[0] === 'search' && args[1] === 'code') {
  const q = String(args[2] ?? '').toLowerCase()
  const hits = (SEARCH[flag('--repo')] ?? []).filter((f) => f.words.some((w) => w.toLowerCase().includes(q) || q.includes(w.toLowerCase())))
  out(hits.map((h) => ({ path: h.path, textMatches: [{ fragment: FILES[flag('--repo')]?.[h.path] ?? '' }] })))
} else if (args[0] === 'issue' && args[1] === 'view') {
  fail('GraphQL: Could not resolve to an issue')
} else if (args[0] === 'pr' && args[1] === 'view' && flag('-R')) {
  fail('GraphQL: Could not resolve to a PullRequest')
} else if (args[0] === 'pr' && (args[1] === 'view' || args[1] === 'diff')) {
  const p = byUrl(args[2])
  if (!p) fail('no such pull request')
  const d = DETAILS[key(p)] ?? { body: '', files: [], diff: '' }
  const files = d.files.map(([path, additions, deletions]) => ({ path, additions, deletions }))
  const fields = flag('--json') ?? ''
  if (args[1] === 'diff') out(d.diff)
  else if (args.includes('--web')) out('')
  else if (fields === 'headRefOid') out({ headRefOid: p.headRefOid })
  else if (fields.startsWith('comments')) out(TALK[key(p)] ?? { comments: [], reviews: [] })
  else
    out({
      title: p.title,
      body: d.body,
      author: p.author,
      baseRefName: 'main',
      headRefName: p.headRefName ?? `feature/${p.number}`,
      labels: [],
      files,
      closingIssuesReferences: [],
    })
} else {
  fail(`fake gh: unsupported: gh ${args.join(' ')}`)
}
