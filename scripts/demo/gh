  timelineItems: { nodes: [{ createdAt: ago(hours), requestedReviewer: { __typename: 'User', login: 'you' } }] },
})
const ci = (state, contexts) => ({
  commits: { nodes: [{ commit: { statusCheckRollup: { state, ...(contexts ? { contexts: { nodes: contexts } } : {}) } } }] },
})
const run = (name, conclusion, id) => ({
  __typename: 'CheckRun',
  name,
  conclusion,
  detailsUrl: `https://github.com/acme/storefront/actions/runs/${id}`,
})

