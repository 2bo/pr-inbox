// Repository files at the PR head, code search hits and upstream release notes, for the AI review
const FILES = {
  'acme/storefront': {
    'CLAUDE.md': '# storefront\n\nClaude, follow these rules when you work in this repository:\n- Ruby on Rails app with a TypeScript frontend in web/\n- All HTTP calls from the frontend go through web/lib/api.ts\n- Every behavior change needs a spec or a vitest test\n- Always run pnpm lint before you finish\n',
    'web/lib/api.ts':
      "import { createClient } from '@acme-oss/http-client'\n\nexport const api = createClient({\n  baseUrl: '/api',\n  retry: { attempts: 3, backoffMs: 200 },\n  timeoutMs: 5000,\n})\n",
    'web/lib/stable.ts': "import stringify from 'fast-json-stable'\n\nexport const cacheKey = (v: unknown) => stringify(v)\n",
    'package.json':
      '{\n  "name": "storefront-web",\n  "private": true,\n  "engines": { "node": ">=20" },\n  "dependencies": {\n    "@acme-oss/http-client": "^2.8.1",\n    "fast-json-stable": "1.4.2"\n  }\n}\n',
    '.nvmrc': '22\n',
  },
}
const SEARCH = {
  'acme/storefront': [
    { path: 'web/lib/api.ts', words: ['@acme-oss/http-client', 'createClient', 'retry', 'http-client'] },
    { path: 'web/lib/stable.ts', words: ['fast-json-stable', 'stringify'] },
  ],
}
const RELEASES = {
  'acme-oss/http-client': [
    {
      tag_name: 'v3.0.0',
      name: 'v3.0.0',
      published_at: ago(24 * 9),
      body: '## Breaking changes\n- The `retry` option of `createClient` is renamed to `retries`. The old name is ignored with no warning.\n- Node.js 18 is no longer supported; Node.js 20 or later is required.\n\n## Features\n- `createClient` accepts `signal` for cancellation.',
    },
    { tag_name: 'v2.8.1', name: 'v2.8.1', published_at: ago(24 * 60), body: '## Fixes\n- Retry on 429 responses honors Retry-After.' },
  ],
  'acme-oss/retry-core': [{ tag_name: 'v2.0.1', name: 'v2.0.1', published_at: ago(24 * 12), body: '## Breaking changes\n- Internal API reshaped for http-client v3. Not used directly by applications.' }],
  'acme-oss/fast-json-stable': [{ tag_name: 'v1.4.3', name: 'v1.4.3', published_at: ago(24 * 20), body: '## Fixes\n- Key ordering for objects with numeric keys now matches the spec.' }],
}

const all = [...REVIEW, ...MINE, ...APPROVED]
const byUrl = (url) => all.find((p) => p.url === url)
const key = (p) => `${p.repository.nameWithOwner.split('/')[1]}/${p.number}`

const args = process.argv.slice(2)
const out = (v) => process.stdout.write(typeof v === 'string' ? v : JSON.stringify(v))

const fail = (msg) => {
  process.stderr.write(`${msg}\n`)
  process.exit(1)
}
const flag = (name) => {
  const i = args.indexOf(name)
  return i >= 0 ? args[i + 1] : undefined
}

if (args[0] === 'api' && args[1] === 'graphql') {
  out({ data: { viewer: { login: 'you' }, review: { nodes: REVIEW }, mine: { nodes: MINE }, approved: { nodes: APPROVED } } })
} else if (args[0] === 'api' && args.includes('event=APPROVE')) {
  out({ state: 'APPROVED' })
} else if (args[0] === 'api') {
  const path = args.find((a) => a.startsWith('repos/')) ?? ''
  let m
  if ((m = path.match(/^repos\/([^/]+\/[^/]+)\/contents\/([^?]+)/))) {
    const file = FILES[m[1]]?.[decodeURIComponent(m[2])]
    if (file === undefined) fail('gh: Not Found (HTTP 404)')
    out(file)
  } else if ((m = path.match(/^repos\/([^/]+\/[^/]+)\/releases/))) {
    const r = RELEASES[m[1]]
    if (!r) fail('gh: Not Found (HTTP 404)')
    out(r)
  } else if ((m = path.match(/^repos\/([^/]+\/[^/]+)\/compare\//))) {
    // What changed since an approval: a made-up two commits, and the PR's own diff
    const p = APPROVED.find((x) => x.repository.nameWithOwner === m[1])
    if (args.includes('--jq')) out({ c: 2, a: 12, d: 3, by: [p?.author.login ?? 'someone'] })
    else out((p && DETAILS[key(p)]?.diff) || 'diff --git a/README.md b/README.md\n--- a/README.md\n+++ b/README.md\n@@ -1,1 +1,1 @@\n-old\n+new\n')
  } else if ((m = path.match(/^repos\/[^/]+\/([^/]+)\/pulls\/(\d+)\/comments$/))) {
    out(LINE_TALK[`${m[1]}/${m[2]}`] ?? [])
  } else fail(`fake gh: unsupported: gh ${args.join(' ')}`)
} else if (args[0] === 'pr' && args[1] === 'merge') {
  out('')
} else if (args[0] === 'stack' && args[1] === '--version') {
  out('gh stack version 0.2.0 (demo)')
} else if (args[0] === 'stack' && args[1] === 'merge') {
  out('')
} else if (args[0] === 'run' && args[1] === 'rerun') {
  out('')
} else if (args[0] === 'search' && args[1] === 'code') {
  const q = String(args[2] ?? '').toLowerCase()
  const hits = (SEARCH[flag('--repo')] ?? []).filter((f) => f.words.some((w) => w.toLowerCase().includes(q) || q.includes(w.toLowerCase())))
  out(hits.map((h) => ({ path: h.path, textMatches: [{ fragment: FILES[flag('--repo')]?.[h.path] ?? '' }] })))
} else if (args[0] === 'issue' && args[1] === 'view') {
  fail('GraphQL: Could not resolve to an issue')
} else if (args[0] === 'pr' && args[1] === 'view' && flag('-R')) {
  fail('GraphQL: Could not resolve to a PullRequest')
} else if (args[0] === 'pr' && (args[1] === 'view' || args[1] === 'diff')) {
  const p = byUrl(args[2])
  if (!p) fail('no such pull request')
  const d = DETAILS[key(p)] ?? { body: '', files: [], diff: '' }
  const files = d.files.map(([path, additions, deletions]) => ({ path, additions, deletions }))
  const fields = flag('--json') ?? ''
  if (args[1] === 'diff') out(d.diff)
  else if (args.includes('--web')) out('')
  else if (fields === 'headRefOid') out({ headRefOid: p.headRefOid })
  else if (fields.startsWith('comments')) out(TALK[key(p)] ?? { comments: [], reviews: [] })
  else
    out({
      title: p.title,
      body: d.body,
      author: p.author,
      baseRefName: 'main',
      headRefName: p.headRefName ?? `feature/${p.number}`,
      labels: [],
      files,
      closingIssuesReferences: [],
    })
} else {
  fail(`fake gh: unsupported: gh ${args.join(' ')}`)
}
